extends CanvasLayer
class_name HUD
# ============================================================
# HUD deliberadamente ambiguo: ya no se muestra el tiempo exacto
# restante (MM:SS). La amenaza se comunica con una frase que
# escala en 4 niveles según GameManager.corruption_level(),
# igual que el velo de color en Zone.gd, para no convertir la
# corrupción en un cronómetro gestionable en vez de una fuente
# de tensión atmosférica.
# ============================================================

var sanity_bar
var status_label

# --- Aviso inferior de confirmación (estilo "Has recogido una nota") ---
# Cola de avisos: se muestran uno tras otro con fundido de entrada/salida.
# Par�metros desde GameManager.GAMEPLAY.hud
var msg_size: Vector2
var msg_scale: float
var msg_duration: float
var msg_fade: float

func _load_hud_params() -> void:
	var gp := GameManager.GAMEPLAY.hud
	msg_size = Vector2(540, 96)  # Could be parameterized later
	msg_scale = 1.35
	msg_duration = gp.message_duration
	msg_fade = 0.25  # Could be parameterized later
var msg_root: Control
var msg_panel: Panel
var msg_icon: TextureRect
var msg_label: Label
var msg_sub: Label
var msg_queue: Array = []
var msg_active := false
var msg_time := 0.0
var msg_last_text := ""

const CORRUPTION_MESSAGES = [
	"Todo se siente extrañamente tranquilo.",
	"Algo en el aire no está bien.",
	"El color se filtra en todo lo que miras.",
	"Ya casi no puedes distinguir qué es real.",
]

func _ready():
	_load_hud_params()
	layer = 5

	var margin = MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 16)
	margin.add_theme_constant_override("margin_top", 16)
	add_child(margin)

	var vbox = VBoxContainer.new()
	vbox.add_theme_constant_override("separation", 8)
	margin.add_child(vbox)

	var sanity_label = Label.new()
	sanity_label.text = "CORDURA"
	sanity_label.add_theme_color_override("font_color", Color(0.78, 0.64, 0.84, 0.96))
	sanity_label.add_theme_font_size_override("font_size", 13)
	vbox.add_child(sanity_label)

	sanity_bar = ProgressBar.new()
	sanity_bar.min_value = 0
	sanity_bar.max_value = GameManager.max_sanity
	sanity_bar.custom_minimum_size = Vector2(180, 16)
	# Style the progress bar
	var bar_style = StyleBoxFlat.new()
	bar_style.bg_color = Color(0.035, 0.03, 0.04, 0.85)
	bar_style.border_color = Color(0.27, 0.21, 0.32, 0.7)
	bar_style.set_border_width_all(1)
	bar_style.set_corner_radius_all(2)
	sanity_bar.add_theme_stylebox_override("background", bar_style)
	var fill_style = StyleBoxFlat.new()
	fill_style.bg_color = Color(0.64, 0.43, 0.73, 0.95)
	fill_style.set_corner_radius_all(2)
	sanity_bar.add_theme_stylebox_override("fill", fill_style)
	vbox.add_child(sanity_bar)

	status_label = Label.new()
	status_label.add_theme_color_override("font_color", Color(0.92, 0.89, 0.94, 0.95))
	status_label.add_theme_font_size_override("font_size", 14)
	status_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	vbox.add_child(status_label)

	var hint = Label.new()
	hint.text = "W/S avanzar · A/D girar · E examinar · C agacharse · Tab diario · Shift correr · Esc pausa"
	hint.add_theme_color_override("font_color", Color(0.62, 0.57, 0.66, 0.82))
	hint.add_theme_font_size_override("font_size", 10)
	vbox.add_child(hint)

	_build_message_box()

	# Avisos que quedaron pendientes de la escena anterior (cambio de zona, Visión).
	for m in GameManager.message_carry:
		msg_queue.append(m)
	GameManager.message_carry.clear()

func _make_panel_style() -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.bg_color = Color(0.012, 0.009, 0.018, 0.88)
	style.border_color = Color(0.34, 0.23, 0.40, 0.78)
	style.set_border_width_all(1)
	style.set_corner_radius_all(2)
	style.content_margin_left = 12
	style.content_margin_right = 12
	style.content_margin_top = 10
	style.content_margin_bottom = 10
	return style

func _build_message_box():
	# Raíz anclada al centro-inferior de la pantalla; se escala en bloque.
	msg_root = Control.new()
	msg_root.anchor_left = 0.5
	msg_root.anchor_right = 0.5
	msg_root.anchor_top = 1.0
	msg_root.anchor_bottom = 1.0
	msg_root.scale = Vector2(msg_scale, msg_scale)
	msg_root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	msg_root.visible = false
	add_child(msg_root)

	msg_panel = Panel.new()
	msg_panel.size = msg_size
	msg_panel.position = Vector2(-msg_size.x / 2.0, -msg_size.y - 18)
	msg_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var style = StyleBoxFlat.new()
	style.bg_color = Color(0.012, 0.009, 0.018, 0.93)
	style.border_color = Color(0.55, 0.39, 0.63, 1.0)
	style.set_border_width_all(1)
	style.set_corner_radius_all(4)
	msg_panel.add_theme_stylebox_override("panel", style)
	msg_root.add_child(msg_panel)

	msg_icon = TextureRect.new()
	msg_icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	msg_icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	msg_icon.position = Vector2(12, 12)
	msg_icon.size = Vector2(72, 72)
	msg_icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	msg_panel.add_child(msg_icon)

	msg_label = Label.new()
	msg_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	msg_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	msg_label.add_theme_color_override("font_color", Color(0.96, 0.90, 0.78, 1.0))
	msg_label.add_theme_font_size_override("font_size", 14)
	msg_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	msg_panel.add_child(msg_label)
	msg_label.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT)

	msg_sub = Label.new()
	msg_sub.add_theme_color_override("font_color", Color(0.72, 0.60, 0.42, 1.0))
	msg_sub.add_theme_font_size_override("font_size", 12)
	msg_sub.mouse_filter = Control.MOUSE_FILTER_IGNORE
	msg_panel.add_child(msg_sub)
	msg_sub.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT)

# API pública (la usa GameManager.show_message).
func show_message(text: String, icon_path: String = "", sub: String = "") -> void:
	# Evita apilar el mismo aviso repetido (p. ej. tocar una salida bloqueada varias veces).
	if text == msg_last_text and (msg_active or msg_queue.size() > 0):
		return
	msg_queue.append({"text": text, "icon": icon_path, "sub": sub})

func _display_message(m: Dictionary) -> void:
	var has_theme_icon = false
	msg_icon.texture = null
	if m.get("icon", "") != "":
		var tex = load(m.icon)
		if tex != null:
			msg_icon.texture = tex
			has_theme_icon = true
	msg_icon.visible = has_theme_icon

	var text_x = 96.0 if has_theme_icon else 20.0
	var text_w = msg_size.x - text_x - 16.0
	var has_sub = m.get("sub", "") != ""
	msg_label.position = Vector2(text_x, 8)
	msg_label.size = Vector2(text_w, 58 if has_sub else 80)
	msg_label.text = m.text
	msg_sub.visible = has_sub
	msg_sub.position = Vector2(text_x, 68)
	msg_sub.size = Vector2(text_w, 20)
	msg_sub.text = m.get("sub", "")

	msg_last_text = m.text
	msg_time = 0.0
	# Si hay más avisos esperando, se acortan un poco para no hacer esperar.
	msg_duration = msg_duration - min(msg_queue.size(), 2) * 0.5
	msg_root.modulate.a = 0.0
	msg_root.visible = true
	msg_active = true

func _update_message(delta):
	if msg_active:
		msg_time += delta
		var a = 1.0
		if msg_time < msg_fade:
			a = msg_time / msg_fade
		elif msg_time > msg_duration - msg_fade:
			a = max(0.0, (msg_duration - msg_time) / msg_fade)
		msg_root.modulate.a = a
		if msg_time >= msg_duration:
			msg_active = false
			msg_root.visible = false
	if not msg_active and msg_queue.size() > 0:
		_display_message(msg_queue.pop_front())

func _process(delta):
	sanity_bar.value = GameManager.sanity
	var level = GameManager.corruption_level()
	var index = int(clamp(level * CORRUPTION_MESSAGES.size(), 0, CORRUPTION_MESSAGES.size() - 1))
	status_label.text = CORRUPTION_MESSAGES[index]

	_update_message(delta)